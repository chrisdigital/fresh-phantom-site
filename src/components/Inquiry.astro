---
/**
 * Inquiry / contact form section.
 * Structure only; form behavior in script tag below.
 * Styles in structure.css + presentation.css.
 */
---

<section id="inquiry" class="inquiry site-section">
  <div class="fp-label inquiry__label">03 / Inquiry</div>
  <div class="fp-divider"></div>
  <div class="inquiry__grid">
    <div class="inquiry__left">
      <h2 class="fp-display inquiry__heading">Have something in mind?</h2>
      <p class="fp-body inquiry__body">
        Tell us what you&rsquo;re working on, what&rsquo;s stuck, or what you think should exist. You do not need a polished brief.
      </p>
      <div class="inquiry__meta">
        <div class="fp-label inquiry__meta-label">Good fit</div>
        <div class="fp-body inquiry__meta-text">New products, identity work, digital systems, experiments, and unusual problems.</div>
      </div>
      <div class="inquiry__meta">
        <div class="fp-label inquiry__meta-label">Working style</div>
        <div class="fp-body inquiry__meta-text">Focused engagements, embedded collaboration, and scoped advisory work.</div>
      </div>
    </div>
    <div class="inquiry__form-panel" data-theme="noir">
      <form id="inquiry-form">
        <div class="inquiry__hp" aria-hidden="true">
          <label for="inquiry-website">Website</label>
          <input id="inquiry-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="inquiry__row">
          <div class="inquiry__field">
            <label class="inquiry__field-label" for="inquiry-name">Name</label>
            <input id="inquiry-name" name="name" type="text" placeholder="Your name" required class="inquiry__input" />
          </div>
          <div class="inquiry__field">
            <label class="inquiry__field-label" for="inquiry-email">Email</label>
            <input id="inquiry-email" name="email" type="email" placeholder="you@company.com" required class="inquiry__input" />
          </div>
        </div>
        <div class="inquiry__field">
          <label class="inquiry__field-label" for="inquiry-verify-email">Verify Email</label>
          <input id="inquiry-verify-email" name="verify_email" type="email" placeholder="Confirm your email" required class="inquiry__input" />
        </div>
        <div class="inquiry__row">
          <div class="inquiry__field">
            <label class="inquiry__field-label" for="inquiry-phone">Phone</label>
            <input id="inquiry-phone" name="phone" type="tel" placeholder="Your phone number" class="inquiry__input" />
          </div>
          <div class="inquiry__field">
            <label class="inquiry__field-label" for="inquiry-verify-phone">Verify Phone</label>
            <input id="inquiry-verify-phone" name="verify_phone" type="tel" placeholder="Confirm your phone" class="inquiry__input" />
          </div>
        </div>
        <div class="inquiry__field">
          <label class="inquiry__field-label" for="inquiry-company">Company / Project</label>
          <input id="inquiry-company" name="company" type="text" placeholder="Optional" class="inquiry__input" />
        </div>
        <div class="inquiry__field">
          <label class="inquiry__field-label" for="inquiry-service">What can we help with?</label>
          <select id="inquiry-service" name="service" class="inquiry__input inquiry__select">
            <option value="" disabled selected>Select a service</option>
            <option value="product">Product Development</option>
            <option value="brand">Branding</option>
            <option value="tech">Technology Consulting</option>
          </select>
        </div>
        <div class="inquiry__field">
          <label class="inquiry__field-label" for="inquiry-message">Tell us about it</label>
          <textarea id="inquiry-message" name="message" rows="3" placeholder="What are you making? What makes it interesting?" class="inquiry__input inquiry__textarea"></textarea>
        </div>
        <div class="inquiry__row inquiry__row--last">
          <div class="inquiry__field">
            <label class="inquiry__field-label" for="inquiry-budget">Budget</label>
            <input id="inquiry-budget" name="budget" type="text" placeholder="Not sure yet" class="inquiry__input" />
          </div>
          <div class="inquiry__field">
            <label class="inquiry__field-label" for="inquiry-timing">Timing</label>
            <input id="inquiry-timing" name="timing" type="text" placeholder="Flexible" class="inquiry__input" />
          </div>
        </div>
        <button type="submit" class="inquiry__submit">
          <span>Send inquiry</span>
          <span>&nearr;</span>
        </button>
        <div id="inquiry-status" class="inquiry__status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script src="../scripts/inquiry_form.ts"></script>
