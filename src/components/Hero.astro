---
/**
 * Hero section — full viewport, editorial layout.
 * Structure only; styles in structure.css + presentation.css.
 */
---

<section id="home" class="hero">
  <div class="hero__content">
    <div class="fp-label hero__eyebrow">Cultural taste × Boutique technology</div>
    <div class="hero__grid">
      <h1 class="fp-display hero__heading">
        <span>Building at the seams of </span>
        <span class="hero__heading--accent">culture, love, and purpose.</span>
      </h1>
      <div>
        <p class="fp-body hero__body">
          Fresh Phantom Labs is a cultural tastemaker and boutique technology firm. We make products, brands, and digital experiences for ideas that deserve more than an ordinary solution.
        </p>
        <div class="hero__actions">
          <a href="#inquiry" class="btn btn--primary btn--lg btn--pill">Let&rsquo;s build something &rarr;</a>
          <a href="#services" class="fp-label hero__explore">Explore what we do &darr;</a>
        </div>
      </div>
    </div>
  </div>
  <div class="hero__bottom">
    <div class="fp-divider"></div>
    <div class="hero__pillars">
      <span class="fp-label hero__pillar">Interesting ideas</span>
      <span class="fp-label hero__pillar">Useful technology</span>
      <span class="fp-label hero__pillar">Distinctive identity</span>
      <span class="fp-label hero__pillar">Purposeful execution</span>
    </div>
  </div>
</section>
