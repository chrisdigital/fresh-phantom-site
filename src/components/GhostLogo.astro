---
/**
 * Fresh Phantom ghost mark — layered icon system.
 *
 * Three layers stacked via CSS:
 *   1. Color div — full solid color fill (the square)
 *   2. Mask SVG — screens the shape; outer area matches page background,
 *      ghost cutout is transparent, revealing the color underneath
 *   3. Icon SVG — detailed line artwork on top
 *
 * The color shows only through the ghost silhouette.
 * Animate `.ghost-logo__color` background-color for ghost-in/ghost-out effects.
 *
 * `bg` prop must match the surrounding background for the mask to blend.
 */
interface Props {
  height?: number;
  color?: string;
  bg?: string;
}

const { height = 30, color = '#C6FF00', bg = '#ECECE8' } = Astro.props;

const aspectRatio = 433.33 / 261.46;
const width = Math.round(height * aspectRatio);
---

<div class="ghost-logo" style={`width:${width}px;height:${height}px;`} aria-label="Fresh Phantom ghost mark" role="img">
  <div class="ghost-logo__color" style={`background-color:${color};`}></div>
  <svg class="ghost-logo__mask" viewBox="0 0 433.33 261.46" xmlns="http://www.w3.org/2000/svg" width={width} height={height}>
    <path fill={bg} d="M0,0h433.33v265.41H0V0ZM331.67,141.76h-.11s41.6-70.75,41.9-71.32c10.83-21.11-4.73-46.49-29.28-46.49l-185.84.29c7.02,5.91,13.47,14.99,15.25,26.1.75,4.71.66,9.78-.57,15.12-.95,4.1-2.57,8.36-5.02,12.74l-20.07,34.1,28.62,1.37c-3.15,5.69-6.77,9.2-10.89,11.35-2.99,1.89-6.49,3-10.16,3h-1.24c-6.39.56-13.71,0-22.07,0h-16.49c-31.94,0-51.04,11.61-77.98,43.8l101.46.79v.03c-.56.93-1.24,1.8-2,2.61-7.05,8.42-17.42,11.42-33.64,11.84-10.43,16.13-26.61,37.43-46.92,51.64h28.07c11.12,0,19.12-1.98,25.5-6.7,2.52-1.86,4.78-4.16,6.88-6.93,7.96-11.06,20.93-17.76,34.89-17.76h.09l-18.47,31.4h7.08c15.51,0,24.98-3.85,32.37-13.64,7.96-11.06,20.93-17.76,34.89-17.76h.08l-18.47,31.4h7.24c15.51,0,24.98-3.85,32.37-13.64,7.96-11.06,20.93-17.76,34.89-17.76h.09l-18.4,31.27c-.64.05-.07.12-.07.12,30.33-1.57,48.83-34.05,56-46.09,2.21-3.72,4.32-7.27,6.02-10.13,10.24-17.22,21.69-23.98,33.53-25.27l-14.83,24.85h1.7c34.02,0,63.46-14.43,77.95-39.59l-74.33-.72Z"/>
  </svg>
  <img class="ghost-logo__icon" src="/assets/fresh_phantom_icon_icon.svg" alt="" width={width} height={height} />
</div>
