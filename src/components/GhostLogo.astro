---
/**
 * Fresh Phantom ghost mark — layered icon system.
 *
 * Three layers stacked via CSS:
 *   1. Color div — full solid color fill (the square)
 *   2. Mask SVG — screens the shape; outer area matches page background,
 *      ghost cutout is transparent, revealing the color underneath
 *   3. Icon SVG — detailed line artwork on top
 *
 * The color shows only through the ghost silhouette.
 * Animate `.ghost-logo__color` background-color for ghost-in/ghost-out effects.
 *
 * `bg` prop must match the surrounding background for the mask to blend.
 */
interface Props {
  height?: number;
  color?: string;
  bg?: string;
}

const { height = 30, color = '#C6FF00', bg = '#ECECE8' } = Astro.props;

const aspectRatio = 374.97 / 241.93;
const width = Math.round(height * aspectRatio);
---

<div class="ghost-logo" style={`width:${width}px;height:${height}px;`} aria-label="Fresh Phantom ghost mark" role="img">
  <div class="ghost-logo__color" style={`background-color:${color};`}></div>
  <svg class="ghost-logo__mask" viewBox="0 0 374.97 241.93" xmlns="http://www.w3.org/2000/svg" width={width} height={height}>
    <path fill={bg} d="M0,0v241.93h374.97V0H0ZM329.47,146.23c-12.94,17.03-35.49,24.32-56.07,25.83l11.61-18.35c-10.82,3.38-22.6,16.79-29.84,25.16h0c-15.46,20.07-37.18,34.26-61.52,40.46l15.09-26.48c-5.48,1.6-13.51,3.82-21.16,12.69-9.85,9.29-19.84,14.83-39.97,16.64l16.72-29.34c-.05,0-.1,0-.15,0-4.52,1.32-10.79,3.07-17.14,8.64l.02-.06c-.09.09-.17.18-.26.26-1.04.92-2.08,1.95-3.11,3.1-9.97,9.6-19.81,15.36-39.87,17.31l16.6-29.12c-4.64,1.35-10.94,3.23-16.98,8.48v-.03s-.06.08-.1.12c-1.11.97-2.2,2.05-3.28,3.27-12.13,11.66-24.06,17.67-54.46,18.01l26.66-46.66c18.64-.35,26.26-15.19,26.26-15.19l-63.78-.41,10.03-12.44c13.05-17.18,34.51-25.19,55.26-26.6,1.03-.15,2.23-.26,3.64-.31,20.45-.78,30.74-4.01,37.94-9.64l-32.31-.23,15-26.26s0,0,0,0c5.68-9.86,15.12-10.18,15.12-10.18h-50.04l14.29-17.74c20.62-27.15,56-38.25,88.36-38.25h87.49v.02c12.81.19,24.62,7.07,31.06,18.19l13.49,23.27-41.5,72.64h55.58l-8.69,13.18Z"/>
  </svg>
  <img class="ghost-logo__icon" src="/assets/fresh_phantom_icon_outline.svg" alt="" width={width} height={height} />
</div>
