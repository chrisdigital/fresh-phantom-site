---
/**
 * Base layout — HTML shell, global CSS import, meta.
 */
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title = "Fresh Phantom",
  description = "Cultural tastemaker and boutique technology firm. Products, brands, and digital experiences for ideas that deserve more than an ordinary solution.",
  noindex = false,
  ogImage = "/assets/og-default.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? "https://www.freshphantom.com");
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL.href} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/assets/fresh_phantom_icon_icon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL.href} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, canonicalURL.origin).href} />
  <meta property="og:site_name" content="Fresh Phantom" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, canonicalURL.origin).href} />
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</head>
<body data-theme="field">
  <slot />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
